{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seed:schema:character-identity-anchor:1.0",
  "title": "THE SEED Character Identity Anchor 1.0 (proposed)",
  "description": "Stable reference linking a global character_id to versioned, player-approved identity and continuity records. It contains references, never private content, and is distinct from the player's real-world identity and from any single world's local save. World portrayals are listed separately and never replace the canonical identity. Status: Phase 0 proposal; the signature proof format is pending an architecture decision and is not verified by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "character_id",
    "anchor_version",
    "canonical_name_ref",
    "provenance",
    "approved_portrayals",
    "policy_versions",
    "latest_update"
  ],
  "properties": {
    "schema": { "const": "seed.character-identity-anchor/1.0" },
    "character_id": {
      "type": "string",
      "pattern": "^seed:character:[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
    },
    "anchor_version": {
      "description": "Monotonic version. Changes only through an authorized, versioned, player-approved update.",
      "type": "integer",
      "minimum": 1
    },
    "canonical_name_ref": {
      "description": "Reference to the player-selected name.",
      "$ref": "#/$defs/content_ref"
    },
    "canonical_appearance_ref": {
      "description": "Reference to the canonical appearance or chosen default presentation.",
      "$ref": "#/$defs/content_ref"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_world", "issuer", "record_ref"],
      "properties": {
        "origin_world": { "$ref": "#/$defs/world_id" },
        "issuer": {
          "type": "string",
          "pattern": "^seed:(identity|world):[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
        },
        "record_ref": { "$ref": "#/$defs/content_ref" }
      }
    },
    "continuity_manifest_ref": {
      "description": "Optional reference to the player-curated Character Continuity Manifest.",
      "$ref": "#/$defs/content_ref"
    },
    "approved_portrayals": {
      "description": "World-specific portrayals the player approved. Each is scoped to its world.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["world", "portrayal_ref", "approved_at"],
        "properties": {
          "world": { "$ref": "#/$defs/world_id" },
          "portrayal_ref": { "$ref": "#/$defs/content_ref" },
          "approved_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy", "portability"],
      "properties": {
        "privacy": { "type": "integer", "minimum": 1 },
        "portability": { "type": "integer", "minimum": 1 }
      }
    },
    "latest_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "approved_at", "signature"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "signature": {
          "description": "Opaque signature value. Format and verification are pending an architecture decision.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "$defs": {
    "world_id": {
      "type": "string",
      "pattern": "^seed:world:[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$"
    },
    "content_ref": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|seed:continuity:[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?)$"
    }
  }
}
